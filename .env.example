# Copy this to .env (or export directly in your shell) before running heal.py
ANTHROPIC_API_KEY=sk-ant-...

# Optional Langfuse tracing (metadata only). Leave unset to disable.
# Region host: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US),
# https://jp.cloud.langfuse.com (Japan)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
